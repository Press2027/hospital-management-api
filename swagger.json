              "type": "string",
              "example": "John"
            },
            "lastName": {
              "type": "string",
              "example": "Doe"
            },
            "age": {
              "type": "integer",
              "example": 30
            },
            "gender": {
              "type": "string",
              "example": "Male"
            },
            "phone": {
              "type": "string",
              "example": "+211912345678"
            },
            "email": {
              "type": "string",
              "example": "john@example.com"
            },
            "bloodGroup": {
              "type": "string",
              "example": "O+"
            },
            "diagnosis": {
              "type": "string",
              "example": "Malaria"
            },
            "address": {
              "type": "string",
              "example": "Juba, South Sudan"
            },
            "registeredDate": {
              "type": "string",
              "example": "2026-09-19"
            },
            "emergencyContact": {
              "type": "string",
              "example": "+211987654321"
            }
          }
        }
      }
    ],
    "responses": {
      "204": {
        "description": "No Content"
      },
