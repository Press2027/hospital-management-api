"/patients/": {
  "get": {
    "tags": ["Patients"],
    "summary": "Get all patients",
    "responses": {
      "200": {
        "description": "OK"
      },
      "500": {
        "description": "Internal Server Error"
      }
    }
  },
  "post": {
    "tags": ["Patients"],
    "summary": "Create a patient",
    "parameters": [
      {
        "name": "body",
        "in": "body",
        "required": true,
        "schema": {
          "type": "object",
          "required": [
            "firstName",
            "lastName",
            "age",
            "gender",
            "phone",
            "email",
            "bloodGroup",
            "diagnosis",
            "address",
            "registeredDate",
            "emergencyContact"
          ],
          "properties": {
            "firstName": {
              "type": "string",
              "example": "John"
            },
            "lastName": {
              "type": "string",
              "example": "Doe"
            },
            "age": {
              "type": "integer",
              "example": 30
            },
            "gender": {
              "type": "string",
              "example": "Male"
            },
            "phone": {
              "type": "string",
              "example": "+211912345678"
            },
            "email": {
              "type": "string",
              "example": "john@example.com"
            },
            "bloodGroup": {
              "type": "string",
              "example": "O+"
            },
            "diagnosis": {
              "type": "string",
              "example": "Malaria"
            },
            "address": {
              "type": "string",
              "example": "Juba, South Sudan"
            },
            "registeredDate": {
              "type": "string",
              "example": "2026-09-19"
            },
            "emergencyContact": {
              "type": "string",
              "example": "+211987654321"
            }
          }
        }
      }
    ],
    "responses": {
      "201": {
        "description": "Created"
      },
      "400": {
        "description": "Bad Request"
      },
      "500": {
        "description": "Internal Server Error"
      }
    }
  }
},

"/patients/{id}": {
  "get": {
    "tags": ["Patients"],
    "summary": "Get patient by ID",
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "type": "string"
      }
    ],
    "responses": {
      "200": {
        "description": "OK"
      },
      "400": {
        "description": "Bad Request"
      },
      "404": {
        "description": "Not Found"
      },
      "500": {
        "description": "Internal Server Error"
      }
